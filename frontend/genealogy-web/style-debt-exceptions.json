{
  "schemaVersion": 2,
  "reviewedAt": "2026-07-29",
  "policy": "A 类系统样式债和 C 类临时兼容债必须持续为零；B 类仅允许稳定 Feature 根作用域下的业务可视化。Issue #961 完成后不得重新登记通用临时兼容例外，新增、移动、重命名或改变规范化条目均视为新的 A 类债务。",
  "businessVisualRules": [
    {
      "id": "b-lineage-visuals",
      "owner": "frontend-lineage",
      "filePattern": "^(src/lineage-(?:graph|tree)\\.css|src/features/tree/.+\\.css)$",
      "selectorPattern": "(node|edge|canvas|graph)",
      "featureRoot": ".lineage-tree-page / .lineage-graph",
      "responsibility": "世系节点、连线和画布业务可视化；不得覆盖标准 Ant Design 控件外围。"
    },
    {
      "id": "b-auth-brand",
      "owner": "frontend-auth",
      "filePattern": "^src/auth-commercial\\.css$",
      "selectorPattern": "(brand|hero|visual|eyebrow|product)",
      "featureRoot": ".commercial-auth-shell",
      "responsibility": "登录页品牌标识、品牌文案和装饰视觉；不得覆盖登录表单控件。"
    }
  ]
}
