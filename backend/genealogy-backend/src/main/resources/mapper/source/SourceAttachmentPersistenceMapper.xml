<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.genealogy.source.repository.mybatis.SourceAttachmentPersistenceMapper"><update id="updateAllById">update source_attachment set source_id=#{sourceId},clan_id=#{clanId},original_filename=#{originalFilename},stored_filename=#{storedFilename},content_type=#{contentType},file_size=#{fileSize},storage_path=#{storagePath},checksum=#{checksum},upload_status=#{uploadStatus},privacy_level=#{privacyLevel},sensitive_level=#{sensitiveLevel},created_by=#{createdBy},created_at=#{createdAt},deleted_at=#{deletedAt} where id=#{id}</update><select id="countActiveByTargets" resultType="com.genealogy.common.persistence.TargetCountRow">select b.target_id as targetId,count(a.id) as count from source_binding b join source_attachment a on a.source_id=b.source_id where b.clan_id=#{clanId} and b.target_type=#{targetType} and b.target_id in <foreach collection="targetIds" item="id" open="(" close=")" separator=",">#{id}</foreach> and b.binding_status&lt;&gt;#{excludedStatus} and a.deleted_at is null group by b.target_id</select></mapper>