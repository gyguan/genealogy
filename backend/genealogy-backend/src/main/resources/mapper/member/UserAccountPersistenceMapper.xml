<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.genealogy.member.repository.mybatis.UserAccountPersistenceMapper"><update id="updateAllById">update user_account set username=#{username},phone=#{phone},email=#{email},display_name=#{displayName},password_hash=#{passwordHash},status=#{status},created_at=#{createdAt},last_login_at=#{lastLoginAt} where id=#{id}</update></mapper>