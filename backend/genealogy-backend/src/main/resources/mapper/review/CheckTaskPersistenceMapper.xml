<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.genealogy.review.repository.mybatis.CheckTaskPersistenceMapper"><update id="updateAllById">update review_task set clan_id=#{clanId},revision_id=#{revisionId},trace_id=#{traceId},review_level=#{reviewLevel},reviewer_id=#{reviewerId},reviewer_role=#{reviewerRole},branch_id=#{branchId},status=#{status},review_comment=#{reviewComment},reviewed_at=#{reviewedAt},created_at=#{createdAt} where id=#{id}</update><select id="selectByIdForUpdate" resultType="com.genealogy.review.entity.CheckTaskEntity">select * from review_task where id=#{taskId} for update</select></mapper>